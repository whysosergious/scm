{
  "name": "@fazelstudio/codemirror-lang-prisma",
  "version": "0.2.0",
  "description": "Prisma Schema Language support for the CodeMirror code editor — syntax highlighting, parsing, and autocomplete",
  "license": "MIT",
  "author": "Zulfazli (Fazelllyyy)",
  "homepage": "https://github.com/fazel-studio/codemirror-lang-prisma#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fazel-studio/codemirror-lang-prisma.git"
  },
  "bugs": {
    "url": "https://github.com/fazel-studio/codemirror-lang-prisma/issues"
  },
  "keywords": [
    "codemirror",
    "codemirror6",
    "cm6",
    "editor",
    "prisma",
    "prisma-schema",
    "lezer",
    "language",
    "syntax-highlighting",
    "autocomplete",
    "intellisense"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "rollup -c",
    "build:grammar": "lezer-generator src/prisma.grammar -o src/parser.js && node scripts/fix-imports.js",
    "watch": "rollup -c -w",
    "test": "mocha test/test-prisma.js",
    "pretest": "npm run build:grammar"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/lr": "^1.4.0"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "chai": "^6.2.2",
    "mocha": "^10.0.0",
    "rollup": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.4.0"
  }
}
